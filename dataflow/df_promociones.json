{
	"name": "df_promociones",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "promociones_csv",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "promociones_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "split1"
				},
				{
					"name": "derivedColumn2"
				}
			],
			"scriptLines": [
				"source(output(",
				"          promocion_id as string,",
				"          nombre_promocion as string,",
				"          fecha_inicio as string,",
				"          fecha_fin as string,",
				"          porcentaje_descuento as string,",
				"          canal_aplicable as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source1 derive(nombre_promocion = replace(replace(replace(replace(replace(initCap(lower(trim(nombre_promocion))), 'á', 'a'), 'é', 'e'), 'í', 'i'), 'ó', 'o'), 'ú', 'u'),",
				"          canal_aplicable = replace(replace(replace(replace(replace(initCap(lower(trim(canal_aplicable))), 'á', 'a'), 'é', 'e'), 'í', 'i'), 'ó', 'o'), 'ú', 'u')) ~> derivedColumn1",
				"derivedColumn1 split(!isNull(promocion_id) && !isNull(nombre_promocion) && !isNull(fecha_inicio) && !isNull(fecha_fin) && !isNull(porcentaje_descuento) && !isNull(canal_aplicable) && toInteger(porcentaje_descuento) > 0 && toInteger(porcentaje_descuento) < 100 ,",
				"     disjoint: false) ~> split1@(validos, rechazados)",
				"split1@validos derive(fecha_inicio = toDate(fecha_inicio),",
				"          fecha_fin = toDate(fecha_fin),",
				"          porcentaje_descuento = toDecimal(porcentaje_descuento)) ~> derivedColumn2",
				"derivedColumn2 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          promocion_id as string,",
				"          nombre_promocion as string,",
				"          fecha_inicio as date,",
				"          fecha_fin as date,",
				"          porcentaje_descuento as decimal(5,2),",
				"          canal_aplicable as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          promocion_id,",
				"          nombre_promocion,",
				"          fecha_inicio,",
				"          fecha_fin,",
				"          porcentaje_descuento,",
				"          canal_aplicable",
				"     )) ~> sink1"
			]
		}
	}
}