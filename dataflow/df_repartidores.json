{
	"name": "df_repartidores",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "repartidores_csv",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "repartidores_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "split1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          repartidor_id as string,",
				"          nombre_repartidor as string,",
				"          tipo_vehiculo as string,",
				"          ciudad_base as string,",
				"          fecha_alta as string,",
				"          activo as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source1 derive(nombre_repartidor = replace(replace(replace(replace(replace(initCap(lower(trim(nombre_repartidor))), 'á', 'a'), 'é', 'e'), 'í', 'i'), 'ó', 'o'), 'ú', 'u'),",
				"          ciudad_base = replace(replace(replace(replace(replace(initCap(lower(trim(ciudad_base))), 'á', 'a'), 'é', 'e'), 'í', 'i'), 'ó', 'o'), 'ú', 'u'),",
				"          activo = replace(initCap(lower(trim(activo))), 'í', 'i'),",
				"          fecha_alta = iif(instr(fecha_alta,'/')>0, toDate(fecha_alta,'dd/MM/yyyy'),toDate(fecha_alta,'yyyy-MM-dd'))) ~> derivedColumn1",
				"derivedColumn1 split(!isNull(repartidor_id) && !isNull(nombre_repartidor) && !isNull(tipo_vehiculo) && !isNull(ciudad_base) && !isNull(fecha_alta) && !isNull(activo),",
				"     disjoint: false) ~> split1@(validos, rechazados)",
				"split1@validos sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          repartidor_id as string,",
				"          nombre_repartidor as string,",
				"          tipo_vehiculo as string,",
				"          ciudad_base as string,",
				"          fecha_alta as date,",
				"          activo as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          repartidor_id,",
				"          nombre_repartidor,",
				"          tipo_vehiculo,",
				"          ciudad_base,",
				"          fecha_alta,",
				"          activo",
				"     )) ~> sink1"
			]
		}
	}
}