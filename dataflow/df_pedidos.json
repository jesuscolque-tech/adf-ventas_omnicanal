{
	"name": "df_pedidos",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "pedidos_csv",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "pedidos_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "split1"
				},
				{
					"name": "derivedColumn2"
				}
			],
			"scriptLines": [
				"source(output(",
				"          pedido_id as string,",
				"          fecha_pedido as string,",
				"          hora_pedido as string,",
				"          cliente_id as string,",
				"          sucursal_id as string,",
				"          canal as string,",
				"          tipo_servicio as string,",
				"          estado_pedido as string,",
				"          promocion_id as string,",
				"          subtotal as string,",
				"          costo_delivery as string,",
				"          descuento as string,",
				"          impuesto as string,",
				"          total_pedido as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source1 derive(canal = replace(replace(replace(replace(replace(replace(initCap(lower(trim(canal))), 'á', 'a'), 'é', 'e'), 'í', 'i'), 'ó', 'o'), 'ú', 'u'),'APP','Aplicacion'),",
				"          tipo_servicio = replace(replace(replace(replace(replace(initCap(lower(trim(tipo_servicio))), 'á', 'a'), 'é', 'e'), 'í', 'i'), 'ó', 'o'), 'ú', 'u'),",
				"          estado_pedido = replace(estado_pedido,'Completado','Entregado'),",
				"          fecha_pedido = iif(instr(fecha_pedido,'/')>0, toDate(fecha_pedido,'dd/MM/yyyy'),toDate(fecha_pedido,'yyyy-MM-dd'))) ~> derivedColumn1",
				"derivedColumn1 split(toDecimal(total_pedido) > 0,",
				"     disjoint: false) ~> split1@(validos, rechazados)",
				"split1@validos derive(subtotal = toDecimal(subtotal),",
				"          costo_delivery = toDecimal(costo_delivery),",
				"          descuento = toDecimal(descuento),",
				"          impuesto = toDecimal(impuesto),",
				"          total_pedido = toDecimal(total_pedido)) ~> derivedColumn2",
				"derivedColumn2 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          pedido_id as string,",
				"          fecha_pedido as date,",
				"          hora_pedido as timestamp,",
				"          cliente_id as string,",
				"          sucursal_id as string,",
				"          canal as string,",
				"          tipo_servicio as string,",
				"          estado_pedido as string,",
				"          promocion_id as string,",
				"          subtotal as decimal(12,2),",
				"          costo_delivery as decimal(12,2),",
				"          descuento as decimal(12,2),",
				"          impuesto as decimal(12,2),",
				"          total_pedido as decimal(12,2)",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          pedido_id,",
				"          fecha_pedido,",
				"          hora_pedido,",
				"          cliente_id,",
				"          sucursal_id,",
				"          canal,",
				"          tipo_servicio,",
				"          estado_pedido,",
				"          promocion_id,",
				"          subtotal,",
				"          costo_delivery,",
				"          descuento,",
				"          impuesto,",
				"          total_pedido",
				"     )) ~> sink1"
			]
		}
	}
}